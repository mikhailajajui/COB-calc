%% cob-calculator — proposed use cases — STATUS: ALL IMPLEMENTED (see docs/spec.md)
%% Originally a gap analysis vs .claude/skills/lending (LendingAnalysis,
%% scripts/lending.py); every PUC1-PUC6 node below now has a shipped implementation
%% (tracked as UC6-UC11 in docs/usecases.mmd) and a corresponding entry in the
%% traceability table in docs/spec.md §10. Kept here as the historical record of the
%% gap analysis that motivated the v2 work — each node still cites the lending-skill
%% method it mirrors and, where relevant, the extension point that was already
%% reserved in src/types.ts before implementation.
flowchart TD
    root(["cob-calculator — proposed v2 use cases"])

    root --> PUC1
    root --> PUC2
    root --> PUC3
    root --> PUC4
    root --> PUC5
    root --> PUC6

    %% --- PUC1: Extra / lump-sum principal payments ---
    PUC1["PUC1: Extra & lump-sum principal payments"]
    PUC1 --> PUC1a["Recurring extra monthly payment\nmirrors lending.extra_payment_savings()\nmonths_saved / interest_saved"]
    PUC1 --> PUC1b["One-time lump sum applied at a renewal\nREADME roadmap item; MortgageInput.lumpSumPayments"]
    PUC1 --> PUC1c["Biweekly payment schedule\n(26 half-payments = 13 full payments/yr)\nlending SKILL.md 'Extra Payments' section"]

    %% --- PUC2: Recurring non-P&I costs ---
    PUC2["PUC2: Recurring costs & PMI"]
    PUC2 --> PUC2a["Property tax / home insurance / HOA\nannual % increase support\nAmortizationEntry.taxPortion / insurancePortion (reserved)"]
    PUC2 --> PUC2b["PMI cost + auto-drop at 80% LTV\nmirrors lending.pmi_cost() + LTV threshold logic"]
    PUC2 --> PUC2c["Cost breakdown output\n(P&I / tax / insurance / PMI / HOA split)\nLoanSummary.costBreakdown (reserved)"]

    %% --- PUC3: Qualification & risk ratios ---
    PUC3["PUC3: Qualification & risk ratios"]
    PUC3 --> PUC3a["Loan-to-Value (LTV)\nmirrors lending.loan_to_value()"]
    PUC3 --> PUC3b["Combined LTV for HELOC / second lien\nmirrors lending.combined_ltv()"]
    PUC3 --> PUC3c["DSCR for investment-property segments\nmirrors lending.debt_service_coverage_ratio()"]

    %% --- PUC4: Alternative payment structures ---
    PUC4["PUC4: Alternative payment structures"]
    PUC4 --> PUC4a["Interest-only segment\nmirrors lending.interest_only_payment()\ndistinct from negative-amortization guard"]
    PUC4 --> PUC4b["Balloon payment reporting\nexpose segment's forced end-balance\nas a named 'balloon due' result\n(computeSegmentSchedule already produces\nthe number, just not labeled as this use case)"]
    PUC4 --> PUC4c["ARM index+margin reset with rate caps\nmirrors lending.arm_payment_after_reset()\ninitial/periodic/lifetime caps —\ncurrent 'variable rate change' segment\ntakes a flat new rate, no cap modeling"]

    %% --- PUC5: Decision / comparison tooling ---
    PUC5["PUC5: Comparison & breakeven tooling"]
    PUC5 --> PUC5a["Mortgage points breakeven\nmirrors lending.points_breakeven()"]
    PUC5 --> PUC5b["Refinance breakeven & total-cost comparison\nmirrors lending.refinance_breakeven()\n+ refinance_total_savings()\n(today a renewal segment has no\nclosing-cost-aware breakeven)"]
    PUC5 --> PUC5c["Side-by-side term comparison\n(e.g. 15-yr vs 30-yr, or two segment plans)\nmirrors lending SKILL.md Example 1"]

    %% --- PUC6: Statement / data-quality tooling ---
    PUC6["PUC6: Statement reconciliation tooling"]
    PUC6 --> PUC6a["Override reason/audit trail\nManualPaymentOverride.reason (reserved, v2)"]
    PUC6 --> PUC6b["Bulk override import from a bank statement\n(CSV/JSON) instead of one-by-one overrides"]

    classDef done fill:#d4edda,stroke:#28a745,color:#14532d;
    class PUC1,PUC2,PUC3,PUC4,PUC5,PUC6,PUC1a,PUC1b,PUC1c,PUC2a,PUC2b,PUC2c,PUC3a,PUC3b,PUC3c,PUC4a,PUC4b,PUC4c,PUC5a,PUC5b,PUC5c,PUC6a,PUC6b done;
