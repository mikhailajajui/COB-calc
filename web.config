<?xml version="1.0" encoding="utf-8"?>
<!--
  Azure App Service on Windows (docs/DEPLOY-AZURE-WINDOWS.md). IIS hands every request to ui/serve.mjs through
  iisnode (entry server.cjs), so the app's own allow-list, Host check and security headers apply as on Linux. IIS never
  serves a file itself.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.cjs" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="All requests to serve.mjs" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.cjs" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering removeServerHeader="true">
        <hiddenSegments>
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
    <httpErrors existingResponse="PassThrough" />
    <iisnode loggingEnabled="true" devErrorsEnabled="false" debuggingEnabled="false" watchedFiles="web.config;server.cjs" />
  </system.webServer>
</configuration>
